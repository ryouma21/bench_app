<main class="main-content">
  <div class="container home-container">
    <% if user_signed_in? %>
      <!-- Today’s Menu タイトル -->
      <div class="section-title">Today’s Menu</div>

      <!-- ▼ 状況に応じた分岐 -->
      <% if @today_menu.present? %>
        <!-- メインメニューカード -->
        <section class="card menu-card">
          <div id="menu-main" class="menu-main-text">
            <% if @today_menu.present? %>
              ベンチプレス <%= @today_menu[:weight] %>kg ×
              <%= @today_menu[:reps] %>回 ×
              <%= @today_menu[:sets] %>セット
            <% else %>
              メニューを作成できません
            <% end %>
          </div>
        <% if false %>
          <div id="menu-sub" class="menu-sub-text">
            休憩：2〜3分 / RPE：8
          </div>

          <div class="menu-advice-label">今日の意識</div>
          <div id="advice" class="menu-advice-text">
            肩をすくめず、胸をしっかり張ることを意識しよう。
          </div>
        <% end %>
        </section>

      <% elsif current_user.training_records.count == 0 %>

       <!--  記録が 0 件のユーザー -->
        <section class="first-user-card card">
          <div class="menu-main-text">
            まだトレーニング記録がありません。
            最初の記録を追加すると、メニューを自動で作成できます。
          </div>

          <div class="mt-3">
            <%= link_to "最初の記録を追加する",
                new_training_record_path,
                class: "btn btn-primary" %>
          </div>
        </section>
        <!-- ▼ 初回ユーザー向けの説明（カードの外に配置） -->
        <div class="first-user-card card">
          <div class="first-user-hint">
            <p>📌 BenchApp は、あなたの記録から自動で<br>
              「今日の最適メニュー」を作成してくれます。</p>
            <p>まずは最初の1件を追加してみましょう。</p>
          </div>
        </div>
      <% else %>
        <!--  記録はあるがメニューが作れない（1RM計算不可など） -->
        <section class="card menu-card">
          <div class="menu-main-text">
            メニューを作成できませんでした。
            記録をもう少し追加してみてください。
          </div>
        </section>
      <% end %>

      <!-- ボタンエリア （メニューがあるときだけ表示）-->
      <% if @today_menu.present? %>
        <div class="button-group">
          <%= link_to new_training_record_path(weight: @today_menu[:weight],
                                              reps:   @today_menu[:reps], 
                                              sets:   @today_menu[:sets]), 
                      id: "record-btn", 
                      class: "btn btn-primary" do %>
          このメニューで記録する
          <% end %>
          <!-- 他のメニュー -->
          <button id="change-btn" class="btn btn-secondary">
            他のメニューを提案してもらう
          </button>
          <!-- ▼ 記録ゼロ or メニュー不可のときは change-btn を出さない 2つのボタン（最初は非表示） -->
          <div id="alt-menu-buttons" class="alt-menu-buttons">
            <button id="lighter-btn" class="btn btn-secondary">
              フォーム重視でやる
            </button>

            <button id="heavier-btn" class="btn btn-secondary">
              刺激を入れてみる
            </button>
          </div>
        </div>
      
      <p class="hint-text" id="menu-hint">
        迷ったら、このメニューから始めればOKです。
      </p>
    <% end %>
    <% else %>
      <!-- ▼ 非ログイン時の画面 -->
      <div class="card welcome-card">
        <h2 class="welcome-title">BenchApp</h2>
        <p class="welcome-desc">
          ベンチプレス中級者のための<br>
          今日の練習メニュー提案アプリ
        </p>
      </div>

      <div class="sample-card">
        <p class="sample-title">📌 ログインするとこんなメニューが見れます</p>

        <div class="card menu-sample">
          <h4 class="sample-menu-main">ベンチプレス 75kg × 5回 × 4セット</h4>
        <% if false %>
          <p class="sample-menu-sub">休憩：2〜3分 / RPE：8</p>
          <p class="sample-menu-advice">肩をすくめず胸を張る意識。</p>
        <% end %>
        </div>
      </div>
    <% end %>
  </div>
</main>