<% if resource.errors.any? %>
  <div class="form-error-message" data-turbo-cache="false">
    <p class="form-error-title">
      <%= resource.errors.count %> 件のエラーがあります
    </p>
    
    <ul class="form-error-list">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
