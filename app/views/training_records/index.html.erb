<div class="main-content">
  <div class="container">

    <h1 class="page-title">記録一覧</h1>

    <div class="add-button-area">
      <%= link_to "＋ 記録を追加", new_training_record_path, class: "btn btn-primary" %>
    </div>

    <% @training_records.each do |record| %>
      <div class="card record-card">
        <div class="record-header">
          <span class="record-date"><%= record.training_date.strftime("%Y/%m/%d") %></span>
          <div class="record-actions">
            <%= link_to "詳細", training_record_path(record), class: "mini-btn mini-btn-blue" %>
            <%= link_to "編集", edit_training_record_path(record), class: "mini-btn mini-btn-green" %>
          </div>
        </div>

        <div class="record-main">
          <span class="weight"><%= record.weight %>kg</span>
          <span class="reps">× <%= record.reps %>回</span>
          <span class="sets">× <%= record.sets %>セット</span>
        </div>

        <div class="record-sub">
          総ボリューム：<%= record.total_volume %>
        </div>

        <div class="record-one-rm">
          推定1RM：
        <% if record.estimated_one_rm.present? %>
          <%= record.estimated_one_rm %> kg
        <% else %>
            -
          <% end %>
        </div>

        <% if record.advice.present? %>
          <div class="record-advice">
            メモ：<%= record.advice %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
<p>過去7日間の合計ボリューム：<%= @weekly_volume %> kg</p>

<canvas id="oneRmChart" width="400" height="200"></canvas>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
document.addEventListener("turbo:load", function() {
  // Ruby の配列 → JS の配列へ
  const oneRmValues = <%= raw @one_rm_values.to_json %>;
  const oneRmDates  = <%= raw @one_rm_dates.to_json %>;

  // canvas を取得（ここにグラフを描く）
  const ctx = document.getElementById('oneRmChart');
  console.log("ctx:", ctx); // ← デバッグ用。必ず出るか確認！

  // Chart.js を使ってグラフを描く
  new Chart(ctx, {
    type: 'line', // 折れ線グラフ
    data: {
      labels: oneRmDates, // X軸（日付）
      datasets: [{
        label: '推定1RM',
        data: oneRmValues, // Y軸（1RMの値）
        borderColor: 'rgba(255, 159, 64, 1)', // オレンジ
        borderWidth: 2,
        tension: 0.3, // 線を少しなめらかに
        fill: false
      }]
    },
    options: {
      responsive: true,
      scales: {
        y: {
          beginAtZero: false
        }
      }
    }
  });
});
</script>