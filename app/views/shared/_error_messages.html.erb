<% if object && object.errors.any? %>
  <div class="form-error-message">
    <p class="form-error-title">
      <%= object.errors.count %> 件のエラーがあります
    </p>

    <ul class="form-error-list">
      <% object.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>
