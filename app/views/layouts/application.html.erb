<!DOCTYPE html>
<html>
  <head>
    <title>BenchApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= user_signed_in? ? '' : 'logged-out' %>">
    <header class="global-header">
      <div class="header-inner">
        <div class="header-left">
          <%= link_to "BenchApp", root_path, class: "header-logo" %>
        </div>
        <nav class="header-right">
          <% if user_signed_in? %>
            <span class="header-user">
              こんにちは、<%= current_user.nickname %> さん！
            </span>
            <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete } ,class: "btn btn-danger"%>
          <% else %>
            <%= link_to "ログイン", new_user_session_path , class: "btn btn-secondary" %>
            <%= link_to "新規登録", new_user_registration_path ,class: "btn btn-primary" %>
          <% end %>
        </nav>
      </div>
    </header>
    <main class="main-content">
      <%= yield %>
    </main>
    <footer class="global-footer">
      <div class="footer-inner">
        <%= link_to root_path, class: "footer-item" do %>
          <div class="footer-icon">🏠</div>
          <div class="footer-text">ホーム</div>
        <% end %>

        <% if user_signed_in? %>
          <%= link_to training_records_path, class: "footer-item" do %>
            <div class="footer-icon">📘</div>
            <div class="footer-text">記録一覧</div>
          <% end %>
          <% if false %>
            <%= link_to "#", class: "footer-item" do %>
              <div class="footer-icon">📝</div>
              <div class="footer-text">フォーム</div>
            <% end %>
          <% end %>
          <%= link_to analysis_path, class: "footer-item", data: { turbo: false } do %>
            <span class="footer-icon">📊</span>
            <span class="footer-text">分析</span>
          <% end %>
          <% else %>
          <%= link_to new_user_session_path, class: "footer-item" do %>
            <div class="footer-icon">🔐</div>
            <div class="footer-text">ログイン</div>
          <% end %>
        <% end %>
      </div>
    </footer>
  </body>
</html>
